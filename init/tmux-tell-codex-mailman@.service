# systemd user template unit for the tmux-tell-codex mailman daemon (the OpenAI
# Codex CLI adapter, #248). Sibling of tmux-tell-claude-mailman@; each adapter
# targets its own daemon (the unit prefix is the binary name). Codex is a new
# adapter with no deprecation alias.
#
# A Codex agent uses hook-context delivery (#248 (B), ADR-0009): its messages are
# presented by `tmux-tell-codex hook-context` from the agent's own session, so the
# mailman `serve` short-circuits at startup (notifies ready, exits cleanly — it
# does not paste). The unit is still installed so `register --start-mailman` and
# the health/systemctl surfaces have a real unit to target, and so a future
# paste-capable Codex configuration has somewhere to land.
#
# Install:
#   cp init/tmux-tell-codex-mailman@.service ~/.config/systemd/user/
#   loginctl enable-linger alex            # so the user manager runs at boot
#   systemctl --user daemon-reload
#   systemctl --user enable --now tmux-tell-codex-mailman@surveyor.service
#
# One instance per recipient agent. The instance name ("%i") is the agent
# name, and is passed through to `tmux-tell-codex serve --agent`.
#
# Logs go to the user journal:
#   journalctl --user -u tmux-tell-codex-mailman@surveyor.service -f

[Unit]
Description=tmux-msg mailman for %i (codex adapter)
Documentation=https://git.frankenbit.de/frankenbit/tmux-msg
# Run after the user session is set up; pane-id discovery (#12) writes the
# agents table before any mailman instance starts.
After=default.target
PartOf=default.target

# alcatraz-infra#583: this mailman writes developer caches under /srv
# (XDG_CACHE_HOME, GOMODCACHE, npm_config_cache — /etc/environment.d/
# 10-cache-on-srv.conf, alcatraz-infra#580). /srv is a SEPARATE LVM VOLUME.
#
# Unmounted, its parent is writable, so `mkdir -p /srv/cache/...` SUCCEEDS on
# the ROOT volume. Those writes are then SHADOWED the moment /srv mounts: still
# consuming root, invisible to `du /srv/cache`, findable only by unmounting.
#
# 🔴 THE HAZARD IS NOT A MISSING DIRECTORY — IT IS THE WRONG FILESYSTEM.
# Nothing errors, every write succeeds, and that is precisely why it goes
# unnoticed. The realistic trigger is not boot (no `nofail`, so a failed mount
# goes to emergency) but MAINTENANCE: an operator unmounting /srv for fsck, a
# resize or a snapshot while these services keep running.
#
# ⚠️ RequiresMountsFor=/srv IS NOT THE GUARD, AND IT LOOKS LIKE ONE. Measured on
# this host: in a systemd --user manager it yields ORDERING ONLY —
#     After=basic.target -.mount srv.mount app.slice
#     Requires=basic.target app.slice          <- srv.mount ABSENT
# and on a path that is not a mount it is inert entirely: a probe unit naming a
# non-existent mountpoint STARTED and ran.
#
# 🔑 AND ExecStartPre IS THE WRONG FORM TOO. A failing ExecStartPre marks the
# unit FAILED and feeds Restart=on-failure: five tries, then StartLimitBurst
# parks it in `failed` needing a manual reset-failed. ConditionPathIsMountPoint
# SKIPS instead -- ActiveState=inactive, Result=success -- so Restart= never
# fires and the unit starts cleanly the moment /srv is back. Three arms:
# non-mount -> ExecStart never runs, rc=0, Result=success; real /srv -> runs;
# a bogus directive IS reported by systemd-analyze, so "it parses" is a real
# claim rather than an absence. (@surveyor, ai#624 review.)
ConditionPathIsMountPoint=/srv

# Restart-flood cap (alcatraz-infra#40 belt-and-suspenders against alcatraz-infra#39
# pattern). After 5 starts in 60s, systemd marks the unit `failed` and stops
# restarting until manual intervention (`systemctl --user reset-failed`).
# v0.16.1 made the original visitor-mailman flood class structurally impossible
# (#338 disables the unit on unregister; #340 exits with 0 on agent-not-found
# so Restart=on-failure doesn't trigger), but the cap is still useful insurance
# against future failure modes that exit non-zero in a tight loop.
StartLimitBurst=5
StartLimitInterval=60s

[Service]
Type=notify
ExecStart=/usr/local/bin/tmux-tell-codex serve --agent %i

# Restart on crash, but back off so a stuck mailman doesn't hot-loop.
Restart=on-failure
RestartSec=2s

# Watchdog: tmux-tell-codex serve pings WATCHDOG=1 every loop iteration when
# WATCHDOG_USEC is exported. systemd kills + restarts the unit if no ping
# arrives within WatchdogSec — covers the case where the loop is wedged
# but the process is still nominally alive (e.g. tmux hung).
WatchdogSec=30s
NotifyAccess=main

# Inherit the operator's PATH and HOME via the user manager. The DB location is
# resolved by the binary itself under user-home (XDG: $XDG_DATA_HOME/tmux-msg or
# ~/.local/share/tmux-msg/messages.db) — the same path the CLI uses, since both
# run under the operator's UID (#308). No Environment=CLAUDE_MSG_DB directive: it
# was a system-global-path footgun (#293) and is unnecessary once the default is
# user-home. (CLAUDE_MSG_DB is the substrate-level DB-path env var, shared across
# adapters.) To pin a bespoke DB, add `Environment=CLAUDE_MSG_DB=...` here AND
# ensure callers use the same path (they no longer match the default otherwise).

# Journal capture with per-instance tag so journalctl filtering is clean.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tmux-tell-codex-mailman-%i

[Install]
WantedBy=default.target
